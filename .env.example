# Application Details
NEXT_PUBLIC_SITE_URL=https://primetalentssolutions.lk
NEXT_PUBLIC_COMPANY_NAME="Prime Talents Solutions (Pvt) Ltd"
NEXT_PUBLIC_BRAND_NAME="Prime Talents Solutions"

# External Job Portal
NEXT_PUBLIC_JOB_PORTAL_URL=https://jobs.primetalentssolutions.lk

# Direct Contact & Messaging
NEXT_PUBLIC_WHATSAPP_NUMBER=+94766955021
NEXT_PUBLIC_CONTACT_PHONE="+94 76 695 5021"
NEXT_PUBLIC_CONTACT_EMAIL=contact@primetalentssolutions.lk

# Email Dispatch Configuration
# Provider Options: 'nodemailer' (for SMTP), 'resend' (for Resend API), or leave empty/'mock' for console logging
EMAIL_PROVIDER=nodemailer

# Target Admin Inquiries Email (where contact form submissions are delivered)
CONTACT_NOTIFICATION_EMAIL=contact@primetalentssolutions.lk
ADMIN_NOTIFICATION_EMAIL=contact@primetalentssolutions.lk

# 1. Nodemailer / SMTP Configuration (Titan, cPanel, Google Workspace, Hostinger, etc.)
# If your business email is hosted with Titan / cPanel / Webmail / Google:
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@primetalentssolutions.lk
SMTP_PASS=your-mailbox-password
SMTP_FROM="Prime Talents Solutions <contact@primetalentssolutions.lk>"

# 2. Resend API Configuration (alternative if using Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM="Prime Talents Solutions <contact@primetalentssolutions.lk>"

# Optional AI Chatbot LLM Provider
OPENAI_API_KEY=
GEMINI_API_KEY=
